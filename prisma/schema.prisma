generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Inquiry {
  id         String   @id @default(cuid())
  company    String?
  source     String   @default("MANUAL")
  rawText    String
  reviewData Json?
  status     String   @default("RECEIVED")
  createdAt  DateTime @default(now())
}
